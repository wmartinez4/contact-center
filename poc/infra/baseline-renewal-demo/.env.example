# Copy to .env and fill in. Phone numbers in E.164 format.
AWS_PROFILE=connect-demo
AWS_REGION=us-east-1
DEMO_PHONE_NUMBER=+1XXXXXXXXXX
DEMO_PHONE_WILLIAM=+57XXXXXXXXXX
DEMO_PHONE_HECTOR=+57XXXXXXXXXX

# Staging email router; loaded by infra/deploy-code.sh into the dialog Lambda only.
EMAIL_ROUTER_URL=
EMAIL_ROUTER_API_KEY=
DEMO_EMAIL_RECIPIENT=
# Exact portal payment URL for the selected renewal; do not reconstruct from the fixture PId.
DEMO_RENEWAL_URL=

# Per-customer attempt cap. Temporarily set to 99 for repeated sandbox rehearsals.
DEMO_MAX_ATTEMPTS=3
